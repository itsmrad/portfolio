# Copy to .env.local for local runs; .env*.local is git-ignored. Vercel holds the real values.

# The visitor counter, live count and visitor map (Upstash Redis REST API). Set by Vercel's
# "Upstash for Redis" integration on Production. Locally they make the footer read, never write.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional search-console verification tokens, as meta tags; DNS verification needs neither.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
